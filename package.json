  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pbarnum/frost-spark-vscode-theme.git"
  },
  "homepage": "https://github.com/pbarnum/frost-spark-vscode-theme/blob/main/README.md",
  "devDependencies": {
    "@vscode/vsce": "^3.7.1"
  }
