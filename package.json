{
  "name": "frost-spark-theme",
  "displayName": "Frost Spark Theme",
  "publisher": "pbarnum",
  "description": "Icy-blue dark theme with a spark of color for VSCode and Cursor",
  "version": "1.1.0",
  "type": "module",
  "keywords": [
    "theme",
    "dark theme",
    "cursor",
    "vscode",
    "frost",
    "blue"
  ],
  "scripts": {
    "build": "node src/index.js",
    "watch": "node src/index.js --watch",
    "deploy": "npm run build && vsce publish",
    "test": "echo tested!"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Themes"
  ],
  "galleryBanner": {
    "color": "#07161b",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Frost Spark Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/frost-spark-dark-color-theme.json"
      }
    ]
  },
  "icon": "assets/icon.png",
